{
  "expo": {
    "name": "Cycle Tracker",
    "slug": "mens-cycle-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF5F8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nathanshabach.cycletracker"
